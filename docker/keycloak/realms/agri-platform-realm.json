  "clients": [
    {
      "clientId": "farmora-web",
      "name": "Farmora Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "account-type-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "account_type",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "account_type",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "farmora-api",
      "name": "Farmora API",
      "description": "Service account the API uses to read the user list for the admin Users page (view-users only).",
      "enabled": true,
      "publicClient": false,
      "secret": "farmora-api-local-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}