KEYCLOAK_VERSION=26.3.3
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local
APP_DB=farmora
APP_DB_USER=farmora
APP_DB_PASSWORD=farmora-local

# Assistant knowledge index and AI service
ES_VERSION=8.17.0
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_INDEX=policy
AI_PORT=8000
# Spring API for live operating rules (seen from inside the ai container).
SITE_API_URL=http://host.docker.internal:8082
# Changing the model requires re-indexing (POST /ingest).
EMBEDDING_MODEL=BAAI/bge-m3
GEMINI_MODEL=gemini-3.5-flash-lite
# always | missing | off — index docs/policy when the ai container starts.
AUTO_INGEST=always
# Optional: reuse the host's Hugging Face cache for the embedding model (saves a 2 GB download).
# HF_CACHE_DIR=/Users/you/.cache/huggingface
# Get one at https://aistudio.google.com/apikey — keep it only in .env, never commit it.
GEMINI_API_KEY=
