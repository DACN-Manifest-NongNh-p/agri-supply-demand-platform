# Copy to backend/.env. The API reads it at start-up; real environment variables win over it.
# Leave the three lines commented out to use the local app-db container (localhost:5433).
# For Neon: Console > Connect > pooling off; JDBC form, user and password on their own lines.
# APP_DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require&channelBinding=require
# APP_DB_USER=neondb_owner
# APP_DB_PASSWORD=<password>
